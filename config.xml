    <!-- Option Chain Monitor API Configuration -->
    <option_monitor>
        <!-- API Server Settings -->
        <api_host>0.0.0.0</api_host>
        <api_port>5000</api_port>
        
        <!-- Monitor Settings -->
        <auto_start>true</auto_start>
        <default_strikes>15</default_strikes>
        <max_symbols>10</max_symbols>
        
